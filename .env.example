# Copy to .env and fill in. Never commit .env.

# --- Database server (docker compose) ---
POSTGRES_PASSWORD=change-me-admin
BOT_READER_PASSWORD=change-me-reader
RAG_WRITER_PASSWORD=change-me-rag
DATA_LOADER_PASSWORD=change-me-loader
DB_HOST=127.0.0.1
DB_PORT=5433

# --- Query execution ---
QUERY_TIMEOUT_MS=5000
MAX_RESULT_ROWS=1000

# --- Dataset uploads ---
MAX_UPLOAD_MB=200
RESTORE_TIMEOUT_S=600

# --- LLM providers (free tiers) ---
# Groq (primary):   https://console.groq.com/keys
GROQ_API_KEY=
# Gemini (fallback; also optional embeddings):   https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Models (LiteLLM names). Free-tier model lists change: check the providers' /models endpoints.
GENERATOR_MODEL=groq/openai/gpt-oss-120b
GENERATOR_FALLBACK_MODEL=gemini/gemini-3.5-flash
JUDGE_MODEL=groq/openai/gpt-oss-20b
JUDGE_FALLBACK_MODEL=gemini/gemini-3.5-flash-lite
# Free-tier limits the router enforces before falling back (Groq: 8000 tokens/min per model).
GROQ_RPM=30
GROQ_TPM=7000
GEMINI_RPM=10

# --- Tracing (optional, used from M8) ---
# LangSmith:   https://smith.langchain.com  (Settings -> API Keys)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=text-to-sql-bot
